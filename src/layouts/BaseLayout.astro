---
import "../styles/global.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const bgSrc = `${base}/assets/background.jpeg`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>Tution Attendance</title>
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect x='1' y='1' width='14' height='14' rx='3' fill='%230d1117' stroke='%2338bd58'/%3E%3Cpath d='M4 8h3l1.5-2.5L12 10' stroke='%2338bd58' stroke-width='1.6' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"
    />
  </head>
  <body>
    <div class="bg" aria-hidden="true">
      <img class="bg-fill" src={bgSrc} alt="" aria-hidden="true" />
      <img class="bg-img" src={bgSrc} alt="" decoding="async" fetchpriority="high" />
    </div>
    <slot />
  </body>
</html>